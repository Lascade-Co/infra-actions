{
  "name": "infra-actions",
  "version": "0.1.0",
  "private": true,
  "description": "Infrastructure tool: reads droplet files from an infra checkout and reconciles Cloudflare, DigitalOcean, OneUptime and the ssh config branch.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "infra": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "infra": "npm run build --silent && node dist/cli.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
