{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Lascade-Co/infra-actions/schema/account.schema.json",
  "title": "Account config",
  "description": "account.yaml in the infra repo: account-level values the tool needs. Real values live only in the private infra repo; no secrets here (tokens come from environment variables).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cloudflare",
    "digitalocean",
    "github",
    "ssh_config",
    "email_domain"
  ],
  "properties": {
    "cloudflare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "team_domain",
        "zones",
        "tunnels",
        "staff_policy_id",
        "service_tokens"
      ],
      "properties": {
        "account_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "team_domain": {
          "description": "Access team domain, e.g. https://example.cloudflareaccess.com",
          "type": "string",
          "pattern": "^https://[a-z0-9-]+\\.cloudflareaccess\\.com$"
        },
        "zones": {
          "description": "Zones droplet names live under.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/domain"
          }
        },
        "tunnels": {
          "description": "Tunnel UUID per DigitalOcean region slug.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/definitions/region"
          },
          "additionalProperties": {
            "$ref": "#/definitions/uuid"
          }
        },
        "staff_policy_id": {
          "description": "UUID of the reusable Access policy \"staff\".",
          "$ref": "#/definitions/uuid"
        },
        "service_tokens": {
          "description": "Every Access service token the droplet files may name (token:<name> in a who-list, e.g. token:ci-prod in ssh:): name -> token UUID.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/uuid"
          }
        },
        "guards": {
          "description": "Delete guard rails. Defaults: 20 deletes, 30% of owned objects.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_deletes": {
              "type": "integer",
              "minimum": 0,
              "default": 20
            },
            "max_delete_fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.3
            }
          }
        }
      }
    },
    "digitalocean": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regions"
      ],
      "properties": {
        "regions": {
          "description": "Region a new droplet of each environment is created in.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prod",
            "staging",
            "internal"
          ],
          "properties": {
            "prod": {
              "$ref": "#/definitions/region"
            },
            "staging": {
              "$ref": "#/definitions/region"
            },
            "internal": {
              "$ref": "#/definitions/region"
            }
          }
        }
      }
    },
    "oneuptime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "project_id"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://[a-z0-9.-]+(:[0-9]{1,5})?$"
        },
        "project_id": {
          "$ref": "#/definitions/uuid"
        },
        "on_call_policy_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/uuid"
          }
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "infra_repo"
      ],
      "properties": {
        "infra_repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
        },
        "ssh_config_branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$",
          "default": "ssh-config"
        },
        "ssh_config_file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "default": "ssh_config"
        }
      }
    },
    "telegram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chat_id"
      ],
      "properties": {
        "chat_id": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        }
      }
    },
    "ssh_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "user": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]*$",
          "default": "ubuntu"
        }
      }
    },
    "email_domain": {
      "description": "The only email domain allowed in who-lists (ssh:, web.access) and in groups, e.g. example.com.",
      "$ref": "#/definitions/domain"
    },
    "groups": {
      "description": "Groups a who-list (ssh:, web.access) may name: group name -> the emails in it (each in email_domain). Not named staff or everyone (built-in who-list names).",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$",
        "not": {
          "enum": [
            "staff",
            "everyone"
          ]
        },
        "x-error": "a group name is lowercase letters, digits and dashes, starting with a letter, and not staff or everyone"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "x-error": "a group must list at least one email",
        "items": {
          "$ref": "#/definitions/email"
        }
      }
    }
  },
  "definitions": {
    "domain": {
      "type": "string",
      "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
      "description": "A lowercase domain such as example.com."
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "A lowercase UUID."
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z]{3}[0-9]$",
      "description": "A DigitalOcean region slug such as nyc1."
    },
    "email": {
      "type": "string",
      "pattern": "^[^@\\s]+@[a-z0-9.-]+\\.[a-z]{2,}$",
      "description": "An email address such as someone@example.com (lowercase domain)."
    }
  }
}
